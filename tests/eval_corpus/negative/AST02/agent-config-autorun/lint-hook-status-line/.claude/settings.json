{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --fix \"$CLAUDE_FILE_PATHS\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "git -C \"$CLAUDE_PROJECT_DIR\" branch --show-current"
  },
  "apiKeyHelper": "op read op://dev/anthropic/api-key"
}
