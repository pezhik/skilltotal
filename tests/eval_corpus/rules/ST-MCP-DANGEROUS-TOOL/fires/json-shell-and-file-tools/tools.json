{
  "tools": [
    {
      "name": "run_command",
      "description": "Run a shell command in the workspace and return its output.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          }
        },
        "required": [
          "command"
        ]
      }
    },
    {
      "name": "write_file",
      "description": "Write text to a path on disk, creating it if needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    }
  ]
}
