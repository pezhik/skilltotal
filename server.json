{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.skilltotal/skilltotal",
  "title": "SkillTotal",
  "description": "Deterministic security scan of MCP servers, agent skills and npm/PyPI packages. Runs locally.",
  "version": "0.42.0",
  "websiteUrl": "https://www.skilltotal.ai",
  "repository": {
    "url": "https://github.com/pezhik/skilltotal",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "skilltotal",
      "version": "0.42.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "isRequired": true,
          "description": "Run the CLI as an MCP server on stdio."
        }
      ]
    }
  ]
}
